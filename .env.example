# Supabase — copy this file to .env.local and fill in real values.
# .env.local is gitignored (matches *.local); never commit real keys.
# In production, set these in the Vercel project's Environment Variables.
# Both are NEXT_PUBLIC_ and are exposed to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
